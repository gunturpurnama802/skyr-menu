# Salin ke .env lalu isi nilainya. Jangan commit file .env.

# PostgreSQL — lokal (Docker) atau Supabase. Karakter khusus di password harus di-encode (% → %25, @ → %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/skyr_menu?schema=public"

# Kunci tanda tangan cookie login admin. Buat dengan: openssl rand -hex 32
SESSION_SECRET=""

# Token Vercel Blob untuk upload gambar menu (Vercel → Storage → Blob → .env.local).
# Kosong di lokal = gambar disimpan ke public/uploads/menu.
BLOB_READ_WRITE_TOKEN=""
